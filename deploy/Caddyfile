# Caddy terminates TLS and spreads players across the game servers.
# Any server can serve any player, so there are no sticky sessions to configure.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Metrics are for your monitoring, not for visitors. Scrape the game servers directly.
	@private path /metrics
	respond @private 404

	reverse_proxy {
		# Re-resolve the "app" service every few seconds, so scaled-up containers join the pool on their own.
		dynamic a {
			name {$APP_HOST:app}
			port {$APP_PORT:8080}
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 10s
	}
}
