# Copy to .env for local runs (node --env-file=.env server/index.js). Every value is optional.

PORT=8080
# HOST=127.0.0.1               # unset = every interface, IPv6 and IPv4
NODE_ENV=production            # caches and pre-compresses static files

# Where rooms live. Unset: in memory, single server, lost on restart (fine for trying it out).
DATABASE_URL=postgres://lom:lom@localhost:5432/lom
# Or spread rooms across several independent PostgreSQL servers:
# DATABASE_URLS=postgres://lom:lom@pg1/lom,postgres://lom:lom@pg2/lom
PG_POOL_SIZE=10
GAMES_RETENTION_DAYS=30        # how long finished games stay in the archive table

TRUST_PROXY=1                  # behind a proxy: 1 = read the player's address from X-Forwarded-For (Caddy, HAProxy);
                               # or name the header, e.g. x-real-ip on Railway
ALLOWED_ORIGINS=               # e.g. https://play.example.com (comma-separated). Empty accepts any origin.
MAX_CONN_PER_IP=60
CREATE_PER_MINUTE=12           # rooms one address may open per minute, per server
